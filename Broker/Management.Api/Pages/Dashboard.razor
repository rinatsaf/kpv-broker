@page "/dashboard"
@using Broker.Contracts
@using global::Api.MonitoringClient
@inject MonitoringClient MonitoringClient
@rendermode RenderMode.InteractiveServer

<h3>Broker Dashboard</h3>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        @_error
    </div>
}

@if (_status == null)
{
    <p>Loading...</p>
}
else
{
    <div class="row">
        <div class="col-md-3">
            <div class="card @(_status.IsHealthy ? "bg-success" : "bg-danger") text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Status</h5>
                    <p class="card-text">@(_status.IsHealthy ? "Healthy" : "Unhealthy")</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-primary text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Queues</h5>
                    <p class="card-text">@_status.TotalQueues</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Messages</h5>
                    <p class="card-text">@_status.TotalMessages</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white mb-3">
                <div class="card-body">
                    <h5 class="card-title">Connections</h5>
                    <p class="card-text">@_status.ActiveConnections</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <h4>Broker Info</h4>
        <p><strong>Version:</strong> @_status.Version</p>
        <p><strong>Uptime:</strong> @TimeSpan.FromSeconds(_status.UptimeSeconds).ToString(@"dd\.hh\:mm\:ss")</p>
    </div>
}

@code {
    private BrokerStatus? _status;
    private string _error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cts = new CancellationTokenSource();
            _status = await MonitoringClient.GetBrokerStatus(cts.Token);
        }
        catch (Exception ex)
        {
            _error = $"Error loading dashboard: {ex.Message}";
        }
    }
}
